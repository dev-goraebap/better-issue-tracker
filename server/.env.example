DB_PATH=./data/bit.db
SERVER_PORT=8080
# Production defaults to Secure cookies. The dev profile disables Secure on local HTTP.
# AUTH_COOKIE_SECURE=true
# AUTH_ALLOWED_ORIGINS=https://bit.example.com
# Optional; absent values are generated in the data directory and must survive restarts.
# AUTH_SECRET=<at-least-32-characters>
# Mail, S3-compatible storage, and Git adapters are added in later tasks.
