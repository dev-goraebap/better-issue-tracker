  <Match><Package name="~io.github.goraebap.bit.jooq.*"/></Match>
  <!-- Constructor injection intentionally keeps references to Spring collaborators. -->
  <Match><Bug pattern="EI_EXPOSE_REP2"/></Match>
</FindBugsFilter>
