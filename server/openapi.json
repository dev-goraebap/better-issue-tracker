  "components" : {
    "schemas" : {
      "Transfer" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "currentPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          }
        },
        "required" : [ "currentPassword", "userId" ]
      },
      "Password" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "Selection" : {
        "type" : "object",
        "properties" : {
          "workspaceId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "workspaceId" ]
      },
      "Create" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "slug" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          }
        },
        "required" : [ "name", "slug" ]
      },
      "Invite" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 256,
            "minLength" : 0
          },
          "role" : {
            "type" : "string",
            "enum" : [ "owner", "admin", "member", "viewer" ]
          }
        },
        "required" : [ "email", "role" ]
