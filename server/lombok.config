# 이 디렉터리 아래의 Lombok 동작을 정한다.

# 상위 경로의 설정을 더 찾지 않는다. 저장소 밖의 설정이 빌드에 끼어들지 않게 한다.
config.stopBubbling = true

# 접근자를 필드명 그대로 만든다 (task.title()). 기본값인 getXxx() 는 이 저장소의 명명
# 규약과 맞지 않으며, 특히 ErrorCode 계약이 요구하는 이름이 status() 와 message() 다.
lombok.accessors.fluent = true

# 생성된 메서드에 @lombok.Generated 를 붙인다. 정적 분석과 커버리지 도구가 우리가 쓰지
# 않은 코드를 검사 대상에서 뺄 수 있다.
lombok.addLombokGeneratedAnnotation = true

# setter 를 쓰지 않는다. 상태 변경은 업무 낱말을 가진 메서드가 하며, 그 메서드가 불변식을
# 함께 지킨다. 필드마다 통로를 내면 그 지점이 사라진다.
lombok.setter.flagUsage = error
