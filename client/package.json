{
  "name": "bit-client",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "api:generate": "openapi-typescript ../server/openapi.json -o src/shared/api/schema.d.ts",
    "lint:fsd": "steiger ./src",
    "lint:components": "node scripts/check-components.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint:components && npm run lint:fsd && npm test && npm run build",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "brand:generate": "node scripts/generate-brand.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.2",
    "@astryxdesign/theme-stone": "0.5.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "lottie-web": "5.13.0",
    "lucide-react": "1.61.0",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.2",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "sharp": "0.35.5",
    "steiger": "0.6.0",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "vite": "8.1.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
